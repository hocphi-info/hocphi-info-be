name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

env:
  # 1 DB Postgres cho ca buoc alembic thu cong lan pytest (TEST_DATABASE_URL
  # tranh conftest.py tu them hau to "_test" — xem tests/conftest.py).
  DATABASE_URL: postgresql+asyncpg://hocphi:hocphi@localhost:5432/hocphi_test
  TEST_DATABASE_URL: postgresql+asyncpg://hocphi:hocphi@localhost:5432/hocphi_test
  REDIS_URL: redis://localhost:6379/0

jobs:
  test:
    runs-on: ubuntu-latest

    services:
      postgres:
        image: postgres:16-alpine
        env:
          POSTGRES_USER: hocphi
          POSTGRES_PASSWORD: hocphi
          POSTGRES_DB: hocphi_test
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U hocphi -d hocphi_test"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 5
      redis:
        image: redis:7-alpine
        ports:
          - 6379:6379
        options: >-
          --health-cmd "redis-cli ping"
          --health-interval 5s
          --health-timeout 3s
          --health-retries 5

    steps:
      - uses: actions/checkout@v4

      - name: Install uv
        uses: astral-sh/setup-uv@v5
        with:
          enable-cache: true
          cache-dependency-glob: uv.lock

      - name: Cai Python 3.12
        run: uv python install 3.12

      - name: uv sync
        run: uv sync --frozen

      - name: ruff check
        run: uv run ruff check .

      - name: ruff format --check
        run: uv run ruff format --check .

      - name: mypy
        run: uv run mypy app tests scripts

      - name: alembic upgrade head
        run: uv run alembic upgrade head

      - name: alembic downgrade base
        run: uv run alembic downgrade base

      - name: alembic upgrade head (lan 2 — round-trip sach)
        run: uv run alembic upgrade head

      - name: pytest
        run: uv run pytest -q

# Copy sang .env roi chinh neu can:  cp .env.example .env
# .env bi gitignore — khong commit gia tri that.

# Postgres — driver asyncpg. Chay local qua Docker: docker compose up -d postgres
DATABASE_URL=postgresql+asyncpg://hocphi:hocphi@localhost:5432/hocphi

# Redis — chua dung toi Tuan 5 (caching). Giu bien cho compose day du.
REDIS_URL=redis://localhost:6379/0

# Origin FE duoc phep goi cheo (CORS), ngan cach bang dau phay.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# In moi cau SQL ra stdout khi debug (true/false).
SQL_ECHO=false
----------------------------------------------------------------------

Gia tri mac dinh trong app/config.py da khop cac dong tren, nen chay duoc
ngay ca khi chua co .env (mien la Postgres dang chay o localhost:5432).
